# Environment variables are configured in the hosting provider, not committed here.
# Required (browser-safe Supabase project URL + publishable/anon key):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternative to VITE_SUPABASE_ANON_KEY:
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Never add SUPABASE_SECRET_KEY or a service-role key to frontend environment variables.
